#include <bits/stdc++.h>
using namespace std;
 
int main() {
	        
	            int t;
	            cin>>t;
	            while(t--){
	                int n;
	                cin>>n;
	                vector<pair<long long,long long>>v(n);
	                for(int i=0;i<n;i++){
	                    cin>>v[i].first;
	                    v[i].second = v[i].first;
	                }
	                
	                for(int i=1;i<n;i++){
	                    v[i].second = max(v[i-1].second,v[i].second);
	                }
	                
	                for(int i=0;i<n-1;i++){
	                    v[i].second = max(v[i+1].second,v[i].second);
	                }
	                
	                long long ans = 0;
	                for(int i=0;i<n;i++){
	                    long long L = v[i].first;
	                    long long R = v[i].second;
	                    
	                    if(L==R){
	                        ans |= L;
	                    }
	                    else{
	                        int msb = 63 - __builtin_clzll(L^R);    
	                        long long orr = R|((1ULL << (msb+1)) - 1);
	                        ans |= orr;
	                    }
	                }
	                
	                cout<<ans<<endl;
	                
	            }
 
}